# Public URL where Postiz is reachable. No trailing slash.
PUBLIC_URL=https://social.example.com

# Where the container port 5000 is published on the host. Keep the loopback
# address when a reverse proxy on the same host terminates TLS.
BIND_ADDRESS=127.0.0.1
BIND_PORT=4007

# Local image built from the Dockerfile in this repository.
POSTIZ_IMAGE=postiz-custom:latest

# Apply the TikTok Sandbox scope patch at build time. Set to false when you
# use a Production-approved TikTok app or do not publish to TikTok.
TIKTOK_SANDBOX_PATCH=true

JWT_SECRET=replace-with-at-least-64-random-characters
POSTIZ_DB_PASSWORD=replace-with-a-long-random-password
DISABLE_REGISTRATION=true

# Meta Production app
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok: use the Sandbox pair for testing, then Production after approval
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
